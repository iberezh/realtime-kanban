# Copy to .env for local development (`pnpm dev`). The API reads this file.

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:3002
# Public app origin for billing return URLs (defaults to CORS_ORIGIN).
APP_URL=http://localhost:3002
# Local Postgres. Use 5433 if 5432 is already taken (and match POSTGRES_PORT below).
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
# Auth secret — at least 16 characters.
JWT_SECRET=change-me-to-a-long-random-string

# --- Stripe billing (optional) ---
# Leave STRIPE_SECRET_KEY blank to run the keyless mock provider (instant upgrades, no payment).
# Generate the two price IDs with: pnpm --filter @kanban/api stripe:setup
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Web ---
# Browser-facing API base (defaults to this value if unset).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- docker compose ---
# Host port for Postgres (change to 5433 if 5432 is taken).
POSTGRES_PORT=5432
