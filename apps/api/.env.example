# API server
PORT=4000
CORS_ORIGIN=http://localhost:3002
# Public app origin for billing return URLs (defaults to CORS_ORIGIN)
APP_URL=http://localhost:3002

# Database — local Postgres. Use 5433 if port 5432 is already taken.
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban

# Auth — must be at least 16 characters
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the Socket.IO Redis adapter for multi-instance scaling.
# Leave blank for single-instance (in-process) realtime.
REDIS_URL=

# Stripe billing — OPTIONAL. Leave blank to run the keyless mock provider
# (upgrades apply instantly, no payment). Prefer a restricted key (rk_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
