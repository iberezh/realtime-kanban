COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

if echo "$COMMIT_MSG" | grep -qE "^Merge|^Revert|^fixup!|^squash!"; then
  exit 0
fi

if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|chore|refactor|docs|test|style|perf|ci|build|revert)(\(.+\))?: .+"; then
  echo "Commit message does not match the required format!"
  echo ""
  echo "Format: <prefix>: <description>"
  echo "Allowed prefixes: feat fix chore refactor docs test style perf ci build revert"
  echo ""
  echo "Examples:"
  echo "  feat: add card drag and drop"
  echo "  fix(api): correct rank computation for head inserts"
  echo ""
  echo "Your commit message:"
  echo "$COMMIT_MSG"
  exit 1
fi
